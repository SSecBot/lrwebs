# Caddy, DOMAIN için Let's Encrypt sertifikasını otomatik alır ve yeniler.
# www. alt alan adını ana alan adına yönlendirmek için alttaki bloğun yorumunu kaldırın.

{$DOMAIN} {
	encode zstd gzip
	# Genel sınır 12 MB; yedek geri yükleme (/api/admin/restore) için 64 MB.
	@restore path /api/admin/restore
	request_body @restore {
		max_size 64MB
	}
	@other not path /api/admin/restore
	request_body @other {
		max_size 12MB
	}
	reverse_proxy lrwebs:3000
}

# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
